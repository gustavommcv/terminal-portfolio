{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "preview": "ng serve --configuration production --prebundle=false --hmr=false",
    "build": "ng build && node scripts/create-build-output.mjs",
    "build:production": "ng build --configuration production && node scripts/create-build-output.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --configuration coverage",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-coverage-lines=97 --test-coverage-branches=90 --test-coverage-functions=90 \"scripts/**/*.test.mjs\"",
    "badges": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-badges.mjs",
    "dev": "ng serve --host 0.0.0.0",
    "lint": "ng lint"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.6.0",
    "badge-maker": "6.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "simple-icons": "16.35.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^4.1.11"
  }
}
